<?xml version="1.0"?>
<ruleset name="Pixely">
    <description>Pixely Platform coding standard — PSR-12</description>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg value="p"/>

    <rule ref="PSR12"/>

    <!-- Test files use PHPUnit-style snake_case method names (test_it_...) and
         Pest files declare helper classes inline next to the tests. -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Classes.ClassDeclaration">
        <exclude-pattern>*/tests/*</exclude-pattern>
        <!-- Laravel migrations may be classes without a namespace. -->
        <exclude-pattern>*/migrations/*</exclude-pattern>
        <exclude-pattern>*/Migrations/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>

    <file>app</file>
    <file>tests</file>
    <file>database</file>
    <file>routes</file>
    <file>config</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/storage/*</exclude-pattern>
    <exclude-pattern>*/bootstrap/cache/*</exclude-pattern>
</ruleset>
