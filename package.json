{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:front": "vite build",
        "dev": "vite",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "security:audit:front": "npm audit",
        "lint": "eslint resources/js app/Core app/Extensions --ext .ts,.vue",
        "lint:fix": "eslint resources/js app/Core app/Extensions --ext .ts,.vue --fix",
        "typecheck": "vue-tsc --noEmit",
        "stylelint": "stylelint \"resources/**/*.{css,scss}\" \"app/Core/**/*.{css,scss}\" \"app/Extensions/**/*.{css,scss}\""
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@types/node": "^26.3.0",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vitest/coverage-v8": "^4.1.11",
        "@vue/test-utils": "^2.5.0",
        "concurrently": "^9.0.1",
        "eslint": "^10.10.0",
        "eslint-plugin-vue": "^10.11.0",
        "express": "^5.2.1",
        "happy-dom": "^20.11.12",
        "laravel-vite-plugin": "^3.1",
        "stylelint": "^17.15.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.0",
        "vite-plugin-vuetify": "^2.1.3",
        "vitest": "^4.1.11",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.11"
    },
    "dependencies": {
        "@mdi/font": "^7.4.47",
        "pinia": "^4.0.3",
        "sass": "^1.103.1",
        "swagger-ui-dist": "^5.32.14",
        "vue": "^3.5.41",
        "vue-router": "^5.2.0",
        "vuetify": "^4.1.12"
    }
}
