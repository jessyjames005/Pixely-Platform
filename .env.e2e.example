APP_NAME="Pixely Platform E2E"
APP_ENV=testing
APP_KEY=
APP_DEBUG=false
APP_URL=http://nginx-e2e

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=mysql-e2e
DB_PORT=3306
DB_DATABASE=pixely_e2e
DB_USERNAME=pixely_e2e
DB_PASSWORD=replace-with-local-secret
E2E_DB_PASSWORD=replace-with-local-secret
E2E_DB_ROOT_PASSWORD=replace-with-another-local-secret
E2E_PASSWORD=replace-with-e2e-user-secret

REDIS_CLIENT=predis
REDIS_HOST=redis-e2e
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=array
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=null
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

SANCTUM_STATEFUL_DOMAINS=nginx-e2e,127.0.0.1:8082,localhost:8082
